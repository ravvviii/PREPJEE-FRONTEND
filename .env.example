# Base URL of the PrepJEE backend API (include /api/v1 prefix)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google OAuth Client ID (same one configured on the backend's GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Amplitude Browser SDK API key (project settings -> API Keys)
NEXT_PUBLIC_AMPLITUDE_KEY=

# Razorpay publishable Key ID (test key while backend is on rzp_test_*)
NEXT_PUBLIC_RAZORPAY_KEY=

# Shown in navbar/metadata/analytics app name property
NEXT_PUBLIC_APP_NAME=PrepJEE

# Canonical frontend URL used by SEO metadata, sitemap, and social sharing
NEXT_PUBLIC_APP_URL=http://localhost:3000
